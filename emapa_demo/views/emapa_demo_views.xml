<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_emapa_demo_list" model="ir.ui.view">
        <field name="name">emapa.demo.list</field>
        <field name="model">emapa.demo</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="description"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_emapa_demo_form" model="ir.ui.view">
        <field name="name">emapa.demo.form</field>
        <field name="model">emapa.demo</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_emapa_demo" model="ir.actions.act_window">
        <field name="name">Registros EMAPA</field>
        <field name="res_model">emapa.demo</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_emapa_root"
        name="EMAPA Demo"
        sequence="10"
    />

    <menuitem
        id="menu_emapa_demo"
        name="Registros"
        parent="menu_emapa_root"
        action="action_emapa_demo"
        sequence="10"
    />

</odoo>
